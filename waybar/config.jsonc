{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 4,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "hyprland/workspaces",
    "mpris",
    "tray"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "cpu",
    "memory",
    "backlight",
    "wireplumber#sink",
    "battery"
  ],
  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 5
    }
  },

  "mpris": {
	  "format": "{dynamic}",
	  "format-paused": "<i>{dynamic}</i>",
	  "max-length": 20
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },
  "cpu": {
    "format": "cpu: {usage}%",
    "interval": 10,
    "on-click": "kitty -e btop"
  },
  "memory": {
	  "interval": 10,
	  "format": "mem: {}%",
	  "max-length": 10,
	  "on-click": "kitty -e btop"
  },
  "backlight": {
    "format": "led: {percent}%",
    "scroll-step": 5,
    "tooltip": false
  },
  "wireplumber#sink": {
    "format": "vol: {volume}%",
    "format-muted": "vol: mut",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "max-volume": 150
  },
  "battery": {
    "interval": 5,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20
    },
    "format": "bat: {capacity}%"
  },
  "idle_inhibitor": {
	  "format": "{icon}",
	  "format-icons": {
		  "activated": "inhi",
		  "deactivated": "idle"
	  },
	  "timeout": 30,
	  "tooltip": false
  },
  "network": {
    "interval": 2,
    "format": "{ifname}",
    "format-wifi": "wifi",
    "format-ethernet": "eth",
    "format-disconnected": "discon",
    "tooltip-format": "{ifname}\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
	  "tooltip-format-wifi": "{essid} ({signalStrength}%)\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
	  "tooltip-format-ethernet": "{ifname}\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
	  "tooltip-format-disconnected": "Disconnected",
	  "on-click": "kitty -e nmtui"
  },
  "clock": {
    "format": "{:%a, %b %d, %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
   	"calendar": {
    		"mode"          : "year",
    		"mode-mon-col"  : 3,
    		"weeks-pos"     : "right",
    		"on-scroll"     : 1,
    		"on-click-right": "mode",
    		"format": {
   			"months":     "<span color='#ffead3'><b>{}</b></span>",
   			"days":       "<span color='#ecc6d9'><b>{}</b></span>",
   			"weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
   			"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
   			"today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
    		}
   	},
    "interval": 10
  }
}

